# ─── AI ────────────────────────────────────────────────────────────────────────
# Gemini API — used by src/services/ai.ts for timetable extraction and study plans
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ─── Supabase (server-side) ──────────────────────────────────────────────────
# Find these in your Supabase project: Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── Vite (browser-exposed) ────────────────────────────────────────────────────
# Variables prefixed with VITE_ are inlined at build time (visible in client bundle).
# Do NOT put secrets here — use the anon key only.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ─── Groq (optional, for ForgeAssistant chat) ────────────────────────────────
# Get your key at: https://console.groq.com
VITE_GROQ_API_KEY=your-groq-api-key-here
